# ── Database ────────────────────────────────────────────────
# "mongo" or "file". If omitted: mongo when MONGODB_URI is set, otherwise file.
# The file driver stores everything in apps/web/data/ (great for local dev).
DB_DRIVER=
MONGODB_URI=
MONGODB_DB=otrelink

# ── Auth ────────────────────────────────────────────────────
# Long random string (32+ characters). In production the app refuses to start without it.
# Generate one with:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# ── URLs ────────────────────────────────────────────────────
# Where the public link page app (apps/page) is served. Used for "View page" links.
NEXT_PUBLIC_PAGE_URL=http://localhost:5173
# Origins allowed to call the public API (comma separated, * for any).
PUBLIC_CORS_ORIGINS=*

# ── Bookings: notifications & reminders ─────────────────────
# Push notifications. Generate the pair once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Secret for the reminders cron (cron-job.org → https://YOUR-APP/api/cron/reminders,
# header  Authorization: Bearer <CRON_SECRET>). Any long random string.
CRON_SECRET=
# Optional: emails with https://resend.com — booking confirmations and reminders, and
# email verification of new accounts (their pages stay hidden until they confirm).
# Without these, new accounts don't need to confirm their email.
RESEND_API_KEY=
EMAIL_FROM="Your Name <bookings@yourdomain.com>"

# ── Plans & payments ────────────────────────────────────────
# Free: 1 page · Pro: $10/month, 10 pages · Business: set by hand in Otrelink-Admin.
# Leave a provider empty to hide its button.
# Stripe (dashboard.stripe.com): create a product "Otrelink Pro" with a $10 monthly price.
STRIPE_SECRET_KEY=          # sk_live_… (or sk_test_… while testing)
STRIPE_PRICE_ID=            # price_…
STRIPE_WEBHOOK_SECRET=      # whsec_…  endpoint: https://YOUR-APP/api/billing/stripe/webhook
# PayPal (developer.paypal.com): create an app, then a product + monthly plan of $10.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=             # P-…
PAYPAL_WEBHOOK_ID=          # webhook for https://YOUR-APP/api/billing/paypal/webhook
PAYPAL_MODE=sandbox         # sandbox | live
# Shown as "Contact us" on the Business plan
BUSINESS_CONTACT_EMAIL=

# ── Admin dashboard (Otrelink-Admin) ────────────────────────
# Long random string (24+ chars). The admin app sends it to /api/admin/*. Empty = admin API off.
ADMIN_API_KEY=

# Legal documents (/terms, /privacy, /cookies, /refunds). Set them before going live.
# Legal name of the business that runs Otrelink (e.g. "Otrelink LLC")
LEGAL_ENTITY_NAME=
# Postal address shown in the policies (default: "Orlando, Florida, United States")
LEGAL_ADDRESS=
# Email for privacy, terms and refund requests (falls back to BUSINESS_CONTACT_EMAIL)
LEGAL_CONTACT_EMAIL=
# Email for copyright (DMCA) notices (falls back to LEGAL_CONTACT_EMAIL)
LEGAL_DMCA_EMAIL=

# ── Uploaded files in Cloudflare R2 (optional) ────────────────
# Without these, uploads are kept in the database. With them, new uploads go to R2 and the
# public page serves them at MEDIA_URL (functions/media/[id].js, bucket bound as MEDIA).
# Move existing files: node --env-file=.env scripts/migrate-assets-to-r2.mjs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MEDIA_URL=https://otrelink.pages.dev/media
